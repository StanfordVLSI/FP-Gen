/*******************************************************************************
 * PARAMETERIZATION
 * ****************************************************************************/
//;  my  $add_weight = parameter(Name=>'AddWeight', Val=>40, Min=>0, Step=>1, Max=>100,
//;	  		      Doc=>"Distribution weight for add instruction to be 1 (range is 0..100)");
//;  my  $nop_weight = parameter(Name=>'NOPWeight', Val=>0, Min=>0, Step=>1,
//;	  		      Doc=>"Distribution weight for nop instruction to be 1");
//;  my  $mul_weight = parameter(Name=>'MulWeight', Val=>30, Min=>0, Step=>1, Max=>100-$add_weight-$nop_weight,
//;	  		      Doc=>"Distribution weight for mul instruction to be 1 (range is 0..100-`$add_weight`-`$nop_weight`)");

class `mname`;

   rand FPGenPkg::InstructionType opcode;

   static int add_weight = `$add_weight`;
   static int mul_weight = `$mul_weight`;
   static int nop_weight = `$nop_weight`;

   // Weighted-random selection of opcode (claude-opus-4-8 wrote the first draft)
   // Assumes nop, add, mul weights are percent probabilities
   // and so i.e. the implied madd weight is 100-(nop+add+mul)
   // Default weights are maybe 40% add, 0% nop, 30% mul (implied 30% fmadd)

   function void set_random();
/*
      int unsigned acc=0, r; r = $urandom_range(0, 99);  // Implies weights should sum to 100
      acc += nop_weight; if (r < acc) opcode = NOP;  else begin
      acc += add_weight; if (r < acc) opcode = FADD; else begin
      acc += mul_weight; if (r < acc) opcode = FMUL; 
                         else         opcode = FMADD;
      end
      end
*/
      int unsigned r = $urandom_range(0, 99);  // Implies weights should sum to 100
      if      (r < nop_weight)                       opcode = NOP;
      else if (r < nop_weight+add_weight)            opcode = FADD;
      else if (r < nop_weight+add_weight+mul_weight) opcode = FMUL;
      else                                           opcode = FMADD;
      





      // $display("%0t FOO I see r=%0d, nopw=%0d, addw=%0d, mulw=%0d",
      //          $time, nop_weight, add_weight, mul_weight);
      // $display("%0t FOO I choose opcode=%s", $time, opcode.name());

   endfunction // set_random

     // Constructor for a Random transaction
     // The constructor also reads user defined, per simulation, weights
     function new();
	if ($test$plusargs("AddWeight")) begin
	   $value$plusargs("AddWeight=%d",  add_weight);
	   $display("%t: `mname`: Runtime input +AddWeight=%d found", $time, add_weight);
	end
	if ($test$plusargs("MulWeight")) begin
	   $value$plusargs("MulWeight=%d",  mul_weight);
	   $display("%t: `mname`: Runtime input +MulWeight=%d found", $time, mul_weight);
	end
	if ($test$plusargs("NOPWeight")) begin
	   $value$plusargs("NOPWeight=%d",  nop_weight);
	   $display("%t: `mname`: Runtime input +NOPWeight=%d found", $time, nop_weight);
	end
     endfunction // new

endclass : `mname`

/*
   // For reference, this is the original constraint-based code, which
   // had to be replaced b/c Verilator does not handle it well.

   constraint pick_inst_type{
      // Assumes that the various weights all add to 100
      // What happens if this gets violated and FMADD<0? FMADD never selected I guess
      // Should issue a warning I suppose
      opcode dist {
		   FPGenPkg::FMADD := 100-mul_weight-add_weight-nop_weight, 
		   FPGenPkg::FADD := add_weight, 
		   FPGenPkg::FMUL := mul_weight, 
		   FPGenPkg::NOP := nop_weight
		   };
   }
*/   
   
