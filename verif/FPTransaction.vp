/*
      (TransType == Random) -> 		
                  {
                   Exponent != `$exp_width`'b0 && 
                   Exponent != {(`$exp_width`){1'b1}} };

*/

/*
        DenormFFF, Max, PointOneOneOne: Exponent = '1; // all ones ('1 means *all* ones, sez chatty bot)

        Denorm100: Exponent = {1'b1, {(FWIDTH-1){1'b0}}};  // 100...0
        Denorm001: Exponent = {{(FWIDTH-1){1'b0}}, 1'b1};  // 00...01

        // ---- Random-with-constraints cases -------------------------------
        DenormRnd: begin                                     // Denorm with no special frac pattern
           do Exponent = frand();
           while (Exponent == '0 || Exponent == '1  ||       // All zeroes or all ones => try again
                  Exponent == {1'b1, {(FWIDTH-1){1'b0}}} ||  // 100* => try again
                  Exponent == {{(FWIDTH-1){1'b0}}, 1'b1});   // 011* => try again
        end
        QuietNaN: begin                                 // 1xx...x
           Exponent = frand();
           Exponent[FWIDTH-1] = 1'b1;
        end
        SignalingNaN: begin                             // 01x...x (MSB=0, rest!=0)
           do Exponent = frand();
           while (Exponent[FWIDTH-2:0] == '0);
           Exponent[FWIDTH-1] = 1'b0;
        end
        EzAndSml: Exponent = FWIDTH'($urandom_range(1, 10));  // Easy and small
        Random:   Exponent = frand();                         // no constraint. to be precise, one has no frets
        default:  Exponent = frand();                         // no constraint
*/


