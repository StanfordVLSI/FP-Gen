class `mname`;
   /* TO ME: Within class definitions, the rand and randc modifiers signal variables 
    * that are to undergo randomization. randc specifies permutation-based randomization, 
    * where a variable will take on all possible values once before any value is repeated. 
    * Variables without modifiers are not randomized. */
   typedef enum {Zero, Denorm100, DenormFFF, Denorm001, DenormRnd, QuietNaN, 
		 SignalingNaN, Min, Max, Inf, One, PointOneOneOne, EzAndSml, Random} FPTransType;

   parameter    FWIDTH = `$frac_width`;
   parameter    EWIDTH = `$exp_width`;

   rand FPTransType        TransType;
   rand bit [FWIDTH - 1:0] Fraction;
   rand bit [EWIDTH - 1:0] Exponent;
   rand bit                Sign;
   rand bit                Inc; // only used to test cascaded architecrures

   // For debugging maybe
   function showtrans(int lno);
      $display("%0t FOOFPT-%0d Sign %b; Exponent 0x%h; Fraction 10'h%h; Inc %b; %s",
               $time,  lno, Sign,    Exponent,      Fraction,        Inc, TransType.name());
        endfunction // showtrans

   \`include "verif/vrand_macros.vh"
   function void vrand(    // vrand() redirects to vrandver/vrandvcs/? according to VRAND value
                       string ABCDE,
                       int    transtype_int,
                       bit    sign,
                       bit    inc
                       );

      // Set transtype according to parm (used when ABCD is "D" or "E")
      FPTransType transtype = FPTransType'(transtype_int);

      \`VRAND(ABCDE, transtype_int, sign, inc);
      // pick_trans_type();  // for random mode etc. ... we're not doing this (yet)
      pick_fraction();
      pick_exponent();
      // showtrans(192)
      // $display("%t: FPGenControl opcode=%s", $time, opcode.name());
   endfunction

   // Transaction counters vor verilator vrand()
   int unsigned idxA = 0;
   int unsigned idxB = 0;
   int unsigned idxC = 0;
   int unsigned idxD = 0;

\`ifndef verilator
   // Verilator dies if it sees this function, thus the "ifndef", also see comment below
   //localparam int unsigned NUM_SETS = 4;
   function void vrandvcs(
                       string ABCDE,
                       FPTransType transtype,
                       bit sign,
                       bit inc
                       );
      case (ABCDE)
        "A": randomize();
        "B": randomize();
        "C": randomize();
        "D": randomize() with { (TransType == transtype) && (Sign == sign) && (Inc == inc); };
        "E": randomize() with { (TransType == transtype) && (Sign == sign); };
      endcase
      /*
      // included for historical reasons, should probably delete tho
      if (ABCDE == "D") begin
         $display("FPTV %0t: %0d: begin Fraction=%h; Exponent=%h; Sign=%h; Inc=%h; TransType=%s; end",
                  $time, idxD, Fraction, Exponent, Sign, Inc, TransType.name());
         idxD = idxD + 1;
      // included for historical reasons, should probably delete tho
      end else if (ABCDE == "C") begin
         $display("%0t FPTransaction vrandC() idxC=%0d setting Inc=%0d", $time, idxC, Inc);
         idxC = idxC + 1;
      end
      */
   endfunction // vrandvcs
\`endif
   
   // Support for verilator, which has problems with constrained randomize().
   // This vrand() function provides predetermined values such that verilator
   // gives exact same results as vcs using randomize() with seed 12345 maybe
   // Currently only works for bf-cma maybe

   function void vrandk(
                           string ABC,
                           int transtype_int,
                           bit sign,
                           bit inc
                          );
      FPTransType transtype = FPTransType'(transtype_int);

      if (ABC == "A") begin
         // -------- OPERAND A --------
         assert (idxA<=8);
         case (idxA)
           0: begin Sign= 0; Exponent= 5'h09; Fraction= 10'h116; Inc= 1; TransType= Random         ; end
           1: begin Sign= 0; Exponent= 5'h0e; Fraction= 10'h3ff; Inc= 0; TransType= PointOneOneOne ; end
           2: begin Sign= 1; Exponent= 5'h1e; Fraction= 10'h3ff; Inc= 0; TransType= Max            ; end
           3: begin Sign= 0; Exponent= 5'h11; Fraction= 10'h3dd; Inc= 1; TransType= Random         ; end
           4: begin Sign= 0; Exponent= 5'h15; Fraction= 10'h3b2; Inc= 1; TransType= Random         ; end
           5: begin Sign= 0; Exponent= 5'h00; Fraction= 10'h200; Inc= 1; TransType= Denorm100      ; end
           6: begin Sign= 0; Exponent= 5'h1e; Fraction= 10'h3ff; Inc= 1; TransType= Max            ; end
           7: begin Sign= 1; Exponent= 5'h09; Fraction= 10'h285; Inc= 0; TransType= Random         ; end
           8: begin Sign= 1; Exponent= 5'h16; Fraction= 10'h0f2; Inc= 0; TransType= Random         ; end
         endcase
         //TransType = Random;
         idxA = idxA + 1;

      end else if (ABC == "B") begin
         // -------- OPERAND B --------
         assert (idxB<=8);
         case (idxB)
           0: begin Sign= 0; Exponent= 5'h1f; Fraction= 10'h000; Inc= 0; TransType= Inf            ; end
           1: begin Sign= 0; Exponent= 5'h0e; Fraction= 10'h3ff; Inc= 1; TransType= PointOneOneOne ; end
           2: begin Sign= 1; Exponent= 5'h1f; Fraction= 10'h1f4; Inc= 1; TransType= SignalingNaN   ; end
           3: begin Sign= 1; Exponent= 5'h1e; Fraction= 10'h3ff; Inc= 0; TransType= Max            ; end
           4: begin Sign= 1; Exponent= 5'h01; Fraction= 10'h000; Inc= 0; TransType= Min            ; end
           5: begin Sign= 0; Exponent= 5'h1f; Fraction= 10'h298; Inc= 0; TransType= QuietNaN       ; end
           6: begin Sign= 1; Exponent= 5'h00; Fraction= 10'h000; Inc= 0; TransType= Zero           ; end
           7: begin Sign= 1; Exponent= 5'h1f; Fraction= 10'h273; Inc= 1; TransType= QuietNaN       ; end
           8: begin Sign= 1; Exponent= 5'h08; Fraction= 10'h2ed; Inc= 0; TransType= Random         ; end
         endcase
         idxB = idxB + 1;

      end else if (ABC == "C") begin
         // -------- OPERAND C --------
         assert (idxC<=9);
         case (idxC)
           0: begin Sign= 1; Exponent= 5'h0e; Fraction= 10'h3ff; Inc= 1; TransType= PointOneOneOne ; end
           1: begin Sign= 0; Exponent= 5'h1e; Fraction= 10'h3ff; Inc= 1; TransType= Max            ; end
           2: begin Sign= 0; Exponent= 5'h11; Fraction= 10'h3ed; Inc= 0; TransType= Random         ; end
           3: begin Sign= 0; Exponent= 5'h1f; Fraction= 10'h20f; Inc= 1; TransType= QuietNaN       ; end
           4: begin Sign= 1; Exponent= 5'h1f; Fraction= 10'h2de; Inc= 1; TransType= QuietNaN       ; end
           5: begin Sign= 0; Exponent= 5'h1e; Fraction= 10'h3ff; Inc= 1; TransType= Max            ; end
           6: begin Sign= 0; Exponent= 5'h07; Fraction= 10'h1dd; Inc= 0; TransType= Random         ; end
           7: begin Sign= 0; Exponent= 5'h04; Fraction= 10'h244; Inc= 1; TransType= Random         ; end
           8: begin Sign= 1; Exponent= 5'h0f; Fraction= 10'h000; Inc= 0; TransType= One            ; end
           9: begin Sign= 1; Exponent= 5'h0f; Fraction= 10'h000; Inc= 1; TransType= One            ; end
         endcase // case (idxC)
         $display("%0t FPTransaction vrandC() idxC=%0d setting Inc=%0d", $time, idxC, Inc);
         idxC = idxC + 1;

      end else if (ABC == "D") begin
         Exponent=5'h1f; Sign=sign; Inc=inc; TransType=transtype;  // Why? dunno
         case (idxD)
           0: Fraction = 10'h000;
           1: Fraction = 10'h31f;
           2: Fraction = 10'h247;
           3: Fraction = 10'h336;
         endcase
         $display("FPTV %0t: %0d: begin Fraction=%h; Exponent=%h; Sign=%h; Inc=%h; TransType=%s; end",
                  $time, idxD, Fraction, Exponent, Sign, Inc, TransType.name());
         idxD = (idxD + 1); // % NUM_SETS;

      // Don't need "E" b/c that is TestMult, not TestFPGen

      end // if (ABC == "D")
      //post_randomize();
   endfunction // vrandk

   // --------------------------------------------------------------------------
   // Some setters:
   // --------------------------------------------------------------------------
   function void ForceFPNum(logic [`$frac_width+$exp_width` : 0] num);
      this.ForceSignExpFrac(num[`$frac_width + $exp_width`], 
			    num[`$frac_width + $exp_width - 1`:`$frac_width`], 
			    num[`$frac_width - 1`:0], 
			    1'b0);
      
   endfunction // ForceFPNum
   
   // Kind of C'tor for a regular, NON-Random transaction
   function void ForceSignExpFrac(logic Sign, logic [`$exp_width - 1`:0] Exp, 
    			     logic [`$frac_width - 1`:0] Frac, logic Inc);
      this.Fraction = Frac;
      this.Exponent = Exp;
      this.Sign = Sign;
      this.Inc = Inc;
      
      if(Exponent == `$exp_width`'b0) begin
	 if (Fraction == `$frac_width`'b0)
	   TransType = Zero;
	 // since we DO care about distinctions within the dnorm range!!!
	 else if(Fraction ==  {1'b1, `$frac_width-1`'b0})
	   TransType = Denorm100;
	 else if(Fraction =={(`$frac_width`){1'b1}})
	   TransType = DenormFFF;
	 else if(Fraction =={`$frac_width-1`'b0, 1'b1})
	   TransType = Denorm001;
	 else
	   TransType = DenormRnd;
      end
      
      else if(Exponent == {(`$exp_width`){1'b1}}) begin
	 if (Fraction == `$frac_width`'b0)
	   TransType = Inf;
	 else begin
	    if (Fraction[`$frac_width-1`] == 1'b1)
	      TransType = QuietNaN;
	    else if (Fraction[`$frac_width-1`] == 1'b0 && Fraction[`$frac_width-2`:0] != `$frac_width-1`'b0)
	      TransType = SignalingNaN;
	    else begin
	      $display("%t: ERROR: FPTransaction constructor encountered an unknown NaN type: Exp=%h, Frac=%h",
		       $time, Exponent, Fraction);
	       $finish(2);
	    end	    
	 end // else: !if(Fraction == `$frac_width`'b0)
      end // if (Exponent == {(`$exp_width`){1'b1}})
      // if it is actually Max
      else if((Fraction == {(`$frac_width`){1'b1}}) && (Exponent == { {(`$exp_width-1`){1'b1}}, 1'b0}))  begin
	 TransType = Max;
      end
      // if it is actually Min
      else if((Fraction == `$frac_width`'b0) && (Exponent == `$exp_width`'b1))  begin
	 TransType = Min;
      end
      // if it is actually One
      else if((Fraction == `$frac_width`'b0) && (Exponent ==  {  1'b0, {(`$exp_width-1`){1'b1}}  }))  begin
	 TransType = One;
      end
      // if it is actually PointOneOneOne
      else if((Fraction ==  {(`$frac_width`){1'b1}} ) && (Exponent ==  {  1'b0, {(`$exp_width-2`){1'b1}}, 1'b0}))  begin
	 TransType = PointOneOneOne;
      end
      else begin
	 TransType = Random; // since we don't care about distinctions within the allowed range
      end // else: !if(Exponent == {(`$exp_width`){1'b1}})
   endfunction // ForceSignExpFrac
   

   
   // Kind of C'tor for a regular, NON-Random transaction using Mantissa instead of Fraction
   // IMPORTANT: This function was custom built for the FPMult format
   function void FPMultResult_to_FPTrans(logic Sign, logic [`$exp_width + 1`:0] Exp, logic [`$frac_width`:0] Man, 
    		 			 logic NaN, logic Inf, logic Zero);
      
      logic [`$frac_width`:0] 		       ManDenormed;
      logic [`$exp_width + 1`:0] 	       expOffset;
      // Start with clear cut flagged cases:
      // ----------------------------------
      if (NaN) begin // NaN cases
	 this.ForceSignExpFrac(Sign, {(`$exp_width`){1'b1}}, `$frac_width`'b1, 1'b0); // FIXME: Signaling? maybe Quiet NaN?
	 return;
      end
      if (Inf) begin // Inf cases
	 this.ForceSignExpFrac(Sign, {(`$exp_width`){1'b1}}, `$frac_width`'b0, 1'b0);
	 return;
      end
      if (Zero) begin // Zero cases
	 this.ForceSignExpFrac(Sign, `$exp_width`'b0, `$frac_width`'b0, 1'b0);
	 return;
      end
      /* RSticky no longer used
       if (RSticky) begin // Rsticky cases
       $write("RSticky==1 ==>  ");
      	 //corner case alert: if FP==1.111111 we need Man<=1.0 and Exp<=Exp+1
      	 if (Man == {(`$frac_width+1`){1'b1}}) begin
	    Man = `$frac_width+1`'b1;
	    Exp = Exp + 1;
	    $display("Man==1.111...1 ==> Exp=Exp+1 and Man=1.0");
	 end
	 else begin
	    Man = Man+1;
	    $display("Man!=1.111...1 ==> Man=Man+1");
	 end
      end
*/
      // Move to unflagged cases:
      // --------------------------- 
      if (Man == `$frac_width+1`'b0) begin // Zero cases
	 this.ForceSignExpFrac(Sign, `$exp_width`'b0, `$frac_width`'b0, 1'b0);
      end
      else if (Exp[`$exp_width+1`] == 1'b1 || Exp == `$exp_width+2`'b0) begin // Negative/Zero  Exp --> Denorm cases
	 
	 //;   if ($test_denormals =~ /YES/){
	 $display("%t \t\t The output exponent is negative(%0d). Denormalization is done before check.", $time, -Exp);

         /* verilator lint_off WIDTHEXPAND */
         // [VERILATOR] Operator ADD expects 7 bits on the RHS, but RHS's CONST '2'h2' generates 2 bits.
	 expOffset = (~Exp + 2'b10);
         /* verilator lint_on WIDTHEXPAND */

	 $display("%b", expOffset);
	 ManDenormed = Man >> expOffset;
	 $display("%d %h", expOffset, ManDenormed);
	 if(|(Man<<`$frac_width+1`-expOffset) || 
	    ManDenormed == `$frac_width+1`'b0) //round up ManDenormed if it is sticky
	   ManDenormed = ManDenormed + `$frac_width+1`'b1;
	  
	 this.ForceSignExpFrac(Sign, `$exp_width`'b0, ManDenormed[`$frac_width - 1`:0], 1'b0);
	 //; } else {
	 //; # Denorm mode is OFF, then the result should be zero
	 $display("%t \t\t The output exponent is negative(%0d), supposed to be ZERO since denorm mode is OFF", $time, -Exp);
	 this.ForceSignExpFrac(Sign, `$exp_width`'b0, `$frac_width`'b0, 1'b0);
	 //; }
      end
      else if (Exp > `2**$exp_width-2`) begin // Exponent overflow case
	 this.ForceSignExpFrac(Sign, {(`$exp_width`){1'b1}}, `$frac_width`'b0, 1'b0);
      end 
      else if (Exp == `$exp_width+2`'b1) begin // Denorm and Normal cases
	 /*if (Man[`$frac_width`] == 1'b0) begin  // Denorm
	    this.ForceSignExpFrac(Sign, `$exp_width`'b0, Man[`$frac_width - 1`:0], 1'b0);
	 end else*/ begin
 	 // Normals (with wxp=1)
	    this.ForceSignExpFrac(Sign, Exp[`$exp_width-1`:0], Man[`$frac_width - 1`:0], 1'b0);
	 end
      end else if (Exp == {(`$exp_width+2`){1'b1}}) begin // Inf and NaN cases
	 this.ForceSignExpFrac(Sign, Exp[`$exp_width-1`:0], Man[`$frac_width - 1`:0], 1'b0);
      end

      // Finally, normal case:
      // ---------------------------
      else begin 		
	 this.ForceSignExpFrac(Sign, Exp[`$exp_width-1`:0], Man[`$frac_width - 1`:0], 1'b0);
      end
   endfunction // FPMultResult_to_FPTrans



   // This function calculates the Inc value into the FP transaction
   function void CalculateInc();
      if (Inc==0) return;
      else if (TransType==Zero) begin
	 Fraction += 1;
	 TransType = Denorm001;
      end
      else if (TransType==DenormFFF) begin
	 Fraction = `$frac_width`'b0;
	 Exponent = `$exp_width`'b1;
	 TransType = Min;
      end
      else if (TransType==Denorm001 || TransType==Denorm100 || TransType==DenormRnd) begin
	 Fraction += 1;
	 if (Fraction == {(`$frac_width`){1'b1}})
	   TransType = DenormFFF;
	 else if (Fraction == {1'b1, `$frac_width-1`'b0})
	   TransType = Denorm100;
	 else
	   TransType = DenormRnd;
      end
      else if (TransType==QuietNaN || TransType==SignalingNaN || TransType==Inf) begin
      end
      else if (TransType==Max) begin
	 Fraction = `$frac_width`'b0;
	 Exponent = {(`$exp_width`){1'b1}};
	 TransType = Inf;
      end
      else if (TransType==PointOneOneOne) begin
	 Fraction = 0;
	 Exponent += 1;
	 TransType = One;
      end
      else if (TransType==Min || TransType==One || TransType==EzAndSml || TransType==Random) begin
	 Fraction += 1;
	 if (Fraction == `$frac_width`'b0) begin
	    Exponent += 1;
	 end
	 TransType = Random;
	 if ((Fraction == {(`$frac_width`){1'b1}}) && Exponent == {1'b0, {(`$exp_width-2`){1'b1}}, 1'b0}) begin
	    TransType = PointOneOneOne;
	 end
	 if ((Fraction == `$frac_width`'b0) && Exponent == {1'b0, {(`$exp_width-1`){1'b1}}}) begin
	    TransType = One;
	 end
      end // if (TransType==Min || TransType==One || TransType==EzAndSml || TransType==Random)
      Inc = 0;
   endfunction // CalculateInc
   

   // --------------------------------------------------------------------------
   // Some getters:
   // --------------------------------------------------------------------------
   function bit IsPos();
      return Sign == 1'b0;
   endfunction // bit IsPos
   
   function bit IsNeg();
      return Sign == 1'b1;
   endfunction // bit IsPos

   function bit [`$frac_width+$exp_width` : 0] GetFPNum();
      bit [`$frac_width+$exp_width` : 0] tmp;
      tmp[`$frac_width + $exp_width`] = this.Sign;
      tmp[`$frac_width + $exp_width - 1`:`$frac_width`] = this.Exponent;
      tmp[`$frac_width - 1`:0] = this.Fraction;
      // $display( "%t: GetFPNum() S=%h E=%h F=%h => tmp=%h", $time, this.Sign, this.Exponent, this.Fraction, tmp);
      return tmp;
   endfunction // GetFPNum
   
   function bit IsDenorm();
      return (TransType == Denorm100)||(TransType == DenormFFF)||(TransType == Denorm001)||(TransType == DenormRnd);
   endfunction// bit IsDenorm
   
   function bit IsMin();
      return (TransType == Min);
   endfunction //bit IsMin
   
   // --------------------------------------------------------------------------
   // Constraints for random generation
   // --------------------------------------------------------------------------
   // To make auto generation of special cases easier:

   // This replaces "constraint pick_fraction_val" b/c verilator is not good with constraints
   function automatic void pick_fraction();
      logic [FWIDTH-1:0] F0 = Fraction;

      unique case (TransType)  // "unique" => all case choices fully covered and mutually exclusive
        // ---- Fixed-value cases -------------------------------------------
        Zero, Min, Inf, One:            Fraction = '0; // all zeroes
        DenormFFF, Max, PointOneOneOne: Fraction = '1; // all ones ('1 means *all* ones, sez chatty bot)

        Denorm100: Fraction = {1'b1, {(FWIDTH-1){1'b0}}};  // 100...0
        Denorm001: Fraction = {{(FWIDTH-1){1'b0}}, 1'b1};  // 00...01

        // ---- Random-with-constraints cases -------------------------------
        DenormRnd: begin                                     // Denorm with no special frac pattern
           do Fraction = frand();
           while (Fraction == '0 || Fraction == '1  ||       // All zeroes or all ones => try again
                  Fraction == {1'b1, {(FWIDTH-1){1'b0}}} ||  // 100* => try again
                  Fraction == {{(FWIDTH-1){1'b0}}, 1'b1});   // 011* => try again
        end
        QuietNaN: begin                                 // 1xx...x
           Fraction = frand();
           Fraction[FWIDTH-1] = 1'b1;
        end
        SignalingNaN: begin                             // 01x...x (MSB=0, rest!=0)
           do Fraction = frand();
           while (Fraction[FWIDTH-2:0] == '0);
           Fraction[FWIDTH-1] = 1'b0;
        end
        EzAndSml: Fraction = FWIDTH'($urandom_range(1, 10));  // Easy and small
        Random:   Fraction = frand();                         // no constraint. to be precise, one has no frets
        default:  Fraction = frand();                         // no constraint
      endcase // unique case (trans_type)

      // if (Fraction != F0) $display("WARNING %s changed fraction value from %h to %h", TransType.name(), F0, Fraction);
   endfunction // pick_fraction
   

   function automatic void pick_exponent();
      logic [FWIDTH-1:0] E0 = Exponent;

      unique case (TransType)  // "unique" => all case choices fully covered and mutually exclusive
        // ---- Fixed-value cases -------------------------------------------

        Zero, Denorm100, DenormFFF:  Exponent = '0; // all zeroes
        Denorm001, DenormRnd:        Exponent = '0; // all zeroes
        QuietNaN, SignalingNaN:      Exponent = '1; // all ones

        Min: Exponent = EWIDTH'(1);
        Max: Exponent = { {(EWIDTH-1){1'b1}}, 1'b0};
        Inf: Exponent = {(`$exp_width`){1'b1}};
        One: Exponent = {  1'b0, {(`$exp_width-1`){1'b1}}  };

        PointOneOneOne: begin
             Exponent = {  1'b0, {(`$exp_width-2`){1'b1}}, 1'b0};
        end

        EzAndSml: begin
           Exponent = erand();
           Exponent[`$exp_width-1`] = 1'b1;
           Exponent[`$exp_width-2`:2] = `$exp_width-3`'b0;
        end
        
        //not denorm, not zero, not inf,not nan, BUT could be Max, Min, One or PointOneOneOne!!!
        Random: begin // Denorm with no special frac pattern
           // do Exponent = erand(); while (Exponent == '0 || Exponent == '1);

           // Mr. Paranoia thinks erand() could break and put us into an infinite loop haha
           Exponent = erand();
           if (Exponent == '0 || Exponent == '1) Exponent = erand();
           if (Exponent == '0 || Exponent == '1) Exponent = erand();
           if (Exponent == '0 || Exponent == '1) Exponent = erand();
           if (Exponent == '0 || Exponent == '1)
             $fatal(2, "ERROR FPTransaction*.v got multiple unlikely values in a row");
        end

        default: Exponent = erand();

      endcase // unique case (trans_type)

      // if (Exponent != E0) $display("WARNING %s changed fraction value from %h to %h", TransType.name(), E0, Exponent);
   endfunction // pick_exponent
   

   // Generate a random fractional part
   function automatic logic [FWIDTH-1:0] frand();
      logic [FWIDTH-1:0] r;
      for (int i = 0; i < (FWIDTH+31)/32; i++)
        r = (r << 32) | $urandom();
      return r;
   endfunction // frand

   // Generate a random exponent part
   function automatic logic [EWIDTH-1:0] erand();
      logic [EWIDTH-1:0] r;
      for (int i = 0; i < (EWIDTH+31)/32; i++)
        r = (r << 32) | $urandom();
      return r;
   endfunction // erand


   // A one-bit function is a boolean
   function bit fraction_all_ones(); return ( Fraction == {(`$frac_width`){1'b1}} ); endfunction // fraction_all_ones
   function bit fraction_is_zero();  return ( Fraction ==    `$frac_width`'b0     ); endfunction // fraction_is_zero


   //workaround for the bug of Random TransType
   function void post_randomize;
      if (TransType == Random) begin
	 
	 if (fraction_all_ones() && (Exponent == { {(`$exp_width-1`){1'b1}}, 1'b0}))  begin
	    // Should not be Random, should instead be Max
	    TransType = Max;
	 end
	 if (fraction_is_zero() && (Exponent == `$exp_width`'b1))  begin
	    // Should not be Random, should instead be Min
	    TransType = Min;
	 end
	 if (fraction_is_zero() && (Exponent ==  {  1'b0, {(`$exp_width-1`){1'b1}}  }))  begin
	    // Should not be Random, should instead be One
	    TransType = One;
	 end
	 if (fraction_all_ones() && (Exponent ==  {  1'b0, {(`$exp_width-2`){1'b1}}, 1'b0}))  begin
	    // Should not be Random, should instead be PointOneOneOne
	    TransType = PointOneOneOne;
	 end
      end    
   endfunction // if


   
   constraint order1 { 
      solve TransType before Fraction, Exponent, Sign, Inc;
   }

   
//;# TODO Random Mode not vetted for verilator yet; would need to rewrite the constraints etc. also see "pick_trans_type2" below
//;# In Random Mode ONLY:
//; if ($rand_mode =~ /YES/){
   /* The following class members hold the DEFAULT weights 
    * for the various transaction types.
    * However, they may be overwritten by the user at runtime
    * using the "+Zero_w=newWeight" notation */
   static bit 	AllWeightsInitialized = 0;	
   static int 	SignIsPos_w = `$SignIsPos_w`;
   static int 	Zero_w = `$Zero_w`;
   static int 	Denorm100_w = `$Denorm100_w`; 
   static int 	DenormFFF_w = `$DenormFFF_w`; 
   static int 	Denorm001_w = `$Denorm001_w`;
   static int 	DenormRnd_w = `$DenormRnd_w`;
   static int 	QuietNaN_w = `$QuietNaN_w`; 
   static int 	SignalingNaN_w = `$SignalingNaN_w`; 
   static int 	Min_w = `$Min_w`; 
   static int 	Max_w = `$Max_w`; 
   static int 	Inf_w = `$Inf_w`; 
   static int 	One_w = `$One_w`; 
   static int 	PointOneOneOne_w = `$PointOneOneOne_w`;
   static int 	EzAndSml_w =`$EzAndSml_w`;
   static int 	Random_w = `$Random_w`;
   
//;# In Random Mode ONLY:
   // The following are constraints blocks for controling and generating
   // meaningful transactions.
   constraint pick_sign{ 
      Sign dist { 0 := SignIsPos_w, 1 := 100-SignIsPos_w }; 
   }
   constraint pick_trans_type{
      TransType dist {Zero := Zero_w, 
		      Denorm100 := Denorm100_w, 
		      DenormFFF := DenormFFF_w, 
		      Denorm001 := Denorm001_w,
		      DenormRnd := DenormRnd_w,
		      QuietNaN := QuietNaN_w, 
		      SignalingNaN := SignalingNaN_w, 
		      Min := Min_w, 
		      Max := Max_w, 
		      Inf := Inf_w, 
		      One := One_w, 
		      PointOneOneOne := PointOneOneOne_w,
		      EzAndSml := EzAndSml_w,
		      Random := Random_w };
   }

//;# In Random Mode ONLY:
   // claude-opus-4-8 wrote the first draft of this one
   // BUT not used except in random-mode
   typedef struct { FPTransType val; int unsigned wt; } trans_weights;
   function automatic FPTransType pick_trans_type2();
      trans_weights w[] = '{
                            '{Zero,           Zero_w},
                            '{Denorm100,      Denorm100_w},
                            '{DenormFFF,      DenormFFF_w},
                            '{Denorm001,      Denorm001_w},
                            '{DenormRnd,      DenormRnd_w},
                            '{QuietNaN,       QuietNaN_w},
                            '{SignalingNaN,   SignalingNaN_w},
                            '{Min,            Min_w},
                            '{Max,            Max_w},
                            '{Inf,            Inf_w},
                            '{One,            One_w},
                            '{PointOneOneOne, PointOneOneOne_w},
                            '{EzAndSml,       EzAndSml_w},
                            '{Random,         Random_w}
                            };
      int unsigned total=0, r, acc=0;

      // Calculate total of all weights T = summa(*_w)
      foreach (w[i]) total += w[i].wt;
      if (total == 0) begin $error("all weights zero"); return Zero; end

      // Choose a number between 0 and T-1 inclusive
      r = $urandom_range(0, total - 1);

      // Walk through the array and return first type that satisfies weight requirement      
      foreach (w[i]) begin
         acc += w[i].wt;
         if (r < acc) return w[i].val;
      end
      $display("WARNING pick_trans_type() FAILED see FPTransaction.vp");
      return Random; // unreachable
   endfunction // pick_trans_type


//;# In Random Mode ONLY:
     // C'tor for a Random transaction
     // The constructor also reads user defined, per simulation, weights
     function new();
	if (! AllWeightsInitialized) begin
	   if ($test$plusargs("SignIsPos_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("SignIsPos_DistWeight`$NamedTransCtrl`=%d",  SignIsPos_w);
	      $display("%t: `mname`: Runtime input +SignIsPos_DistWeight`$NamedTransCtrl`=%d found", $time, SignIsPos_w);
	   end
	   //;   if ($inc_enable eq 'YES'){
	   if ($test$plusargs("Inc_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Inc_DistWeight`$NamedTransCtrl`=%d",  Inc_w);
	      $display("%t: `mname`: Runtime input +Inc_DistWeight`$NamedTransCtrl`=%d found", $time, Inc_w);
	   end
	   //;   }
	   if ($test$plusargs("Zero_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Zero_DistWeight`$NamedTransCtrl`=%d",  Zero_w);
	      $display("%t: `mname`: Runtime input +Zero_DistWeight`$NamedTransCtrl`=%d found", $time, Zero_w);
	   end
	   //;   if ($test_denormals =~ /YES/){
	   if ($test$plusargs("Denorm100_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Denorm100_DistWeight`$NamedTransCtrl`=%d",  Denorm100_w);
	      $display("%t: `mname`: Runtime input +Denorm100_DistWeight`$NamedTransCtrl`=%d found", $time, Denorm100_w);
	   end
	   if ($test$plusargs("DenormFFF_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("DenormFFF_DistWeight`$NamedTransCtrl`=%d",  DenormFFF_w);
	      $display("%t: `mname`: Runtime input +DenormFFF_DistWeight`$NamedTransCtrl`=%d found", $time, DenormFFF_w);
	   end
	   if ($test$plusargs("Denorm001_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Denorm001_DistWeight`$NamedTransCtrl`=%d",  Denorm001_w);
	      $display("%t: `mname`: Runtime input +Denorm001_DistWeight`$NamedTransCtrl`=%d found", $time, Denorm001_w);
	   end
	   if ($test$plusargs("DenormRnd_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("DenormRnd_DistWeight`$NamedTransCtrl`=%d",  DenormRnd_w);
	      $display("%t: `mname`: Runtime input +DenormRnd_DistWeight`$NamedTransCtrl`=%d found", $time, DenormRnd_w);
	   end
	   //;   } # End of "if ($test_denormals..."	   
	   if ($test$plusargs("QuietNaN_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("QuietNaN_DistWeight`$NamedTransCtrl`=%d",  QuietNaN_w);
	      $display("%t: `mname`: Runtime input +QuietNaN_DistWeight`$NamedTransCtrl`=%d found", $time, QuietNaN_w);
	   end
	   if ($test$plusargs("SignalingNaN_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("SignalingNaN_DistWeight`$NamedTransCtrl`=%d",  SignalingNaN_w);
	      $display("%t: `mname`: Runtime input +SignalingNaN_DistWeight`$NamedTransCtrl`=%d found", $time, SignalingNaN_w);
	   end
	   if ($test$plusargs("Min_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Min_DistWeight`$NamedTransCtrl`=%d",  Min_w);
	      $display("%t: `mname`: Runtime input +Min_DistWeight`$NamedTransCtrl`=%d found", $time, Min_w);
	   end
	   if ($test$plusargs("Max_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Max_DistWeight`$NamedTransCtrl`=%d",  Max_w);
	      $display("%t: `mname`: Runtime input +Max_DistWeight`$NamedTransCtrl`=%d found", $time, Max_w);
	   end
	   if ($test$plusargs("Inf_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Inf_DistWeight`$NamedTransCtrl`=%d",  Inf_w);
	      $display("%t: `mname`: Runtime input +Inf_DistWeight`$NamedTransCtrl`=%d found", $time, Inf_w);
	   end
	   if ($test$plusargs("One_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("One_DistWeight`$NamedTransCtrl`=%d",  One_w);
	      $display("%t: `mname`: Runtime input +One_DistWeight`$NamedTransCtrl`=%d found", $time, One_w);
	   end
	   if ($test$plusargs("PointOneOneOne_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("PointOneOneOne_DistWeight`$NamedTransCtrl`=%d",  PointOneOneOne_w);
	      $display("%t: `mname`: Runtime input +PointOneOneOne_DistWeight`$NamedTransCtrl`=%d found", $time, PointOneOneOne_w);
	   end
	   if ($test$plusargs("EzAndSml_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("EzAndSml_DistWeight`$NamedTransCtrl`=%d",  EzAndSml_w);
	      $display("%t: `mname`: Runtime input +EzAndSml_DistWeight`$NamedTransCtrl`=%d found", $time, EzAndSml_w);
	   end
	   if ($test$plusargs("Random_DistWeight`$NamedTransCtrl`")) begin
	      $value$plusargs("Random_DistWeight`$NamedTransCtrl`=%d",  Random_w);
	      $display("%t: `mname`: Runtime input +Random_DistWeight`$NamedTransCtrl`=%d found", $time, Random_w);
	   end
	end // if (! AllWeightsInitialized)
     endfunction // new
//; } # End of "if ($rand_mode =~ /YES/)..."

endclass : `mname`



